        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/templates/claude/hooks/context-mcp-post-tool-use.js\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
